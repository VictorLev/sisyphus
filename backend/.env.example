# All optional — these are the defaults.
PORT=7479
# Relative to the backend/ directory. The file is created on first run.
DB_PATH=./data/sisyphus.db

# Creates the first account on an empty database (ignored once any account
# exists). Or skip these and run `npm run add-user -- <name> --admin`.
#ADMIN_USERNAME=
#ADMIN_PASSWORD=

# Set to the number of proxies in front of the app (1 behind cloudflared) so
# client IPs and HTTPS are read from X-Forwarded-*. Leave unset for local dev.
#TRUST_PROXY=

# Where `npm run backup` writes. Defaults to a backups/ folder beside the DB.
#BACKUP_DIR=
