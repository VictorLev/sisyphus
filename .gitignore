# Route videos on the server, beside the compose file.
/deploy/routes/
.env

# Source media: full-resolution originals stay local; only the optimised
# web copies under frontend/ are committed. Leading slash anchors this to
# the repo root so it does not also swallow frontend/media/.
/media/

# Database backups on the server (deploy/update.sh, sisyphus-backup.timer).
/deploy/backups/
