[Unit]
Description=Pull and redeploy Sisyphus (backs up first when the image changed)
After=network-online.target docker.service remote-fs.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/mnt/storage/docker/sisyphus
# Through sh, so the script needs no exec bit on the NFS share.
ExecStart=/bin/sh /mnt/storage/docker/sisyphus/update.sh
