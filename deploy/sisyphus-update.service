# Deploys the latest Sisyphus release (backup first, health check after,
# automatic rollback). Started nightly by sisyphus-update.timer; deploy
# right away with:
#   sudo systemctl start sisyphus-update.service
[Unit]
Description=Pull and redeploy Sisyphus, backing up first
After=network-online.target docker.service remote-fs.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# victor is in the docker group. Running as victor rather than root means
# the folder on NFS (.env, backups/) is read and written as its owner.
User=victor
WorkingDirectory=/mnt/storage/docker/sisyphus
# Through sh, so the script needs no exec bit on the NFS share.
ExecStart=/bin/sh /mnt/storage/docker/sisyphus/update.sh
