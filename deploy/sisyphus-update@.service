# Deploys one Sisyphus instance; %i is its folder under /mnt/storage/docker
# (sisyphus = prod, sisyphus-staging = staging). Started by
# sisyphus-update.timer (prod, nightly) and sisyphus-staging-update.timer
# (staging, every 5 min). Deploy prod right away with:
#   sudo systemctl start sisyphus-update@sisyphus.service
[Unit]
Description=Pull and redeploy Sisyphus (%i), backing up first
After=network-online.target docker.service remote-fs.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# victor is in the docker group. Running as victor rather than root means
# the folder on NFS (.env, backups/) is read and written as its owner, which
# root may not be allowed to do on the share.
User=victor
WorkingDirectory=/mnt/storage/docker/%i
# Through sh, so the script needs no exec bit on the NFS share.
ExecStart=/bin/sh /mnt/storage/docker/%i/update.sh
