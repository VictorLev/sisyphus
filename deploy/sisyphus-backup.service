[Unit]
Description=Back up the Sisyphus database
After=docker.service remote-fs.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/mnt/storage/docker/sisyphus
# Online backup through the running container; keeps the last 14.
ExecStart=/usr/bin/docker exec sisyphus node scripts/backup.js --tag nightly --keep 14
