[Unit]
Description=Back up the Sisyphus prod database
After=docker.service remote-fs.target
Requires=docker.service

[Service]
Type=oneshot
User=victor
WorkingDirectory=/mnt/storage/docker/sisyphus
# Online backup through the running prod container; keeps the last 14.
ExecStart=/usr/bin/docker exec sisyphus node scripts/backup.js --tag nightly --keep 14
