# Copy to .env beside docker-compose.yml on the server and fill in. This is
# the ONLY place the secrets live: never commit it, never put these values
# in the code, the tests or the image. The compose folder is on the NFS
# share, which Samba also exports, so lock the file down:
#   chmod 600 .env
#
# Quote a value in single quotes if it contains $, # or spaces:
#   ADMIN_PASSWORD='pa$$ word'

# Your own admin account, created on the first start if no account exists
# yet. Every ride from before accounts existed becomes this account's. After
# that first start these two are ignored: change your password in the app
# (Settings -> Account) or with `docker exec sisyphus npm run reset-password`.
ADMIN_USERNAME=victor
ADMIN_PASSWORD=

# The Cloudflare Tunnel. Leave both commented out until the build with
# logins is running; uncommenting them is what exposes the app to the
# internet. TUNNEL_TOKEN: Zero Trust -> Networks -> Tunnels -> your tunnel ->
# the long string after `--token` in the install command.
#COMPOSE_PROFILES=tunnel
#TUNNEL_TOKEN=

# Which image to run. Leave commented out to follow main. To roll back, set
# the full commit SHA of a known-good build, then run update.sh.
#IMAGE_TAG=0123456789abcdef0123456789abcdef01234567

# Optionally pin cloudflared (tags at hub.docker.com/r/cloudflare/cloudflared).
#CLOUDFLARED_TAG=latest
