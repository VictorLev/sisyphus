# Copy to deploy/.env on the server and fill in. This is the ONLY place the
# secrets live: never commit .env (it is gitignored), and never put these
# values in the code, the tests or the image.
#
# Quote a value in single quotes if it contains $, # or spaces:
#   ADMIN_PASSWORD='pa$$ word'

# The Cloudflare Tunnel token (Zero Trust -> Networks -> Tunnels -> your
# tunnel -> the long string after `--token` in the install command).
TUNNEL_TOKEN=

# Your own admin account, created on the first start if no account exists
# yet. All rides from before accounts existed become this account's. After
# that first start these two are ignored; to change your password use
# Settings -> Account, or `docker compose exec app npm run reset-password`.
ADMIN_USERNAME=victor
ADMIN_PASSWORD=

# Which image to run. Leave commented out to follow main. To roll back, set
# it to the full commit SHA of a known-good build (from the GitHub Actions
# run or `git log`), then run `sudo ./update.sh`.
#IMAGE_TAG=0123456789abcdef0123456789abcdef01234567

# Optionally pin cloudflared too (tags at hub.docker.com/r/cloudflare/cloudflared).
#CLOUDFLARED_TAG=latest
