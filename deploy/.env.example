# Copy to .env beside docker-compose.yml in each instance's folder and fill
# in. This is the ONLY place the secrets live: never commit it, never put
# these values in the code, the tests or the image. The folders are on the
# NFS share, which Samba also exports, so lock the file down:
#   chmod 600 .env
#
# Quote a value in single quotes if it contains $, # or spaces:
#   ADMIN_PASSWORD='pa$$ word'

# ---------------------------------------------------------------- prod
# /mnt/storage/docker/sisyphus/.env

# Your own admin account, created on the first start if no account exists
# yet. Every ride from before accounts existed becomes this account's. After
# that first start these two are ignored: change your password in the app
# (Settings -> Account) or with `docker exec sisyphus npm run reset-password`.
ADMIN_USERNAME=victor
ADMIN_PASSWORD=

# The Cloudflare Tunnel (prod only). Leave both commented out until a build
# with logins is running; uncommenting them is what exposes the app to the
# internet. TUNNEL_TOKEN: Zero Trust -> Networks -> Tunnels -> your tunnel ->
# the long string after `--token` in the install command.
#COMPOSE_PROFILES=tunnel
#TUNNEL_TOKEN=

# Which image prod runs. Unset = stable (the last v* release tag). To roll
# back, pin an earlier release (IMAGE_TAG=v1.2.0) or a full commit SHA, then
# run update.sh.
#IMAGE_TAG=v1.2.0

# Optionally pin cloudflared (tags at hub.docker.com/r/cloudflare/cloudflared).
#CLOUDFLARED_TAG=latest

# ------------------------------------------------------------- staging
# /mnt/storage/docker/sisyphus-staging/.env. Its data is a nightly copy of
# prod's, so it has prod's accounts. ADMIN_* is only needed for the very
# first refresh, while prod has no accounts yet; use the same values.
#
# SISYPHUS_ROLE=staging
# ADMIN_USERNAME=victor
# ADMIN_PASSWORD=
# IMAGE_TAG=latest
# CONTAINER_NAME=sisyphus-staging
# HOST_PORT=3011
